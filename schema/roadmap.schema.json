{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "locales": {
          "default": [
            "en"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "public": {
          "default": false,
          "type": "boolean"
        },
        "public_url": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_phase": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "labels": {
          "default": {
            "in_progress": [
              "status:in-progress",
              "status/in-progress",
              "status:review",
              "status/review"
            ],
            "blocked": [
              "status:blocked",
              "status:needs-human",
              "status/blocked",
              "blocked"
            ],
            "done": [
              "status/done"
            ],
            "ready": [
              "ready",
              "status/ready"
            ],
            "phase": {}
          },
          "type": "object",
          "properties": {
            "in_progress": {
              "default": [
                "status:in-progress",
                "status/in-progress",
                "status:review",
                "status/review"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocked": {
              "default": [
                "status:blocked",
                "status:needs-human",
                "status/blocked",
                "blocked"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "done": {
              "default": [
                "status/done"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ready": {
              "default": [
                "ready",
                "status/ready"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "phase": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "fleet_env": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "mechanics_waves": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "default": {
            "label": null
          },
          "type": "object",
          "properties": {
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "presentation": {
          "default": {
            "show_blocked_as": "in-progress"
          },
          "type": "object",
          "properties": {
            "show_blocked_as": {
              "default": "in-progress",
              "type": "string",
              "enum": [
                "in-progress",
                "planned"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "project",
        "repo",
        "title",
        "version",
        "updated",
        "current_phase"
      ],
      "additionalProperties": false
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "gets_you": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^\\d{4}(-Q[1-4]|-H[12])?$"
          },
          "visibility": {
            "default": "public",
            "type": "string",
            "enum": [
              "public",
              "internal"
            ]
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
            }
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "kind": {
            "default": "epic",
            "type": "string",
            "enum": [
              "theme",
              "epic",
              "wave"
            ]
          },
          "area": {
            "type": "string"
          },
          "visibility": {
            "default": "internal",
            "type": "string",
            "enum": [
              "public",
              "internal"
            ]
          },
          "depends_on": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
            }
          },
          "issues": {
            "default": [],
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "tasks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "acceptance": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "verify": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "blocked_by": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "labels": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fleet_env": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "interactive": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "title",
                "acceptance",
                "verify"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "planned",
              "dropped"
            ]
          },
          "since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string"
          },
          "mechanics_wave": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "owners": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "links": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "clients": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "phase"
        ],
        "additionalProperties": false
      }
    },
    "milestones": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "summary": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "phase": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "items": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
            }
          },
          "status": {
            "default": "draft",
            "type": "string",
            "enum": [
              "draft",
              "planned",
              "reached",
              "dropped"
            ]
          },
          "date": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "decision",
                      "commitment",
                      "contract",
                      "release",
                      "user"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "kind",
                  "by",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reached_at": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "visibility": {
            "default": "public",
            "type": "string",
            "enum": [
              "public",
              "internal"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "phase"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "meta",
    "phases"
  ],
  "additionalProperties": false,
  "$id": "https://nextup.hansenexus.dev/schema/roadmap.schema.json",
  "title": "nextup roadmap.yaml"
}
